{
  "name": "game-builder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:aws": "next build",
    "deploy:aws": "bash scripts/deploy-aws.sh",
    "invite:create": "bash scripts/create-participant-code.sh",
    "user:invite": "bash scripts/invite-user.sh",
    "organizer:set": "bash scripts/set-organizer.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build:aws && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "companion:doctor": "node companion/gameforge.mjs doctor",
    "companion:generate": "node companion/gameforge.mjs generate",
    "companion:serve": "node companion/gameforge.mjs serve",
    "verify:local-llm": "node scripts/verify-local-llm.mjs",
    "verify:bedrock": "node --env-file-if-exists=.env.local --import tsx scripts/verify-bedrock.mjs",
    "graph:package": "bash scripts/package-graph-worker.sh",
    "graph:deploy": "bash scripts/deploy-graph-worker.sh"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1093.0",
    "@aws-sdk/client-dynamodb": "^3.1093.0",
    "@aws-sdk/client-lambda": "^3.1093.0",
    "@aws-sdk/client-neptune-graph": "^3.1093.0",
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/lib-dynamodb": "^3.1093.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@rolldown/binding-darwin-arm64": "^1.0.1",
    "jose": "^6.2.4",
    "next": "^16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "esbuild": "^0.27.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.14",
    "sharp": "0.35.0"
  },
  "type": "module"
}
