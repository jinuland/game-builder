# Existing StoryForge integration (separate local project)
STORYFORGE_API_URL=http://127.0.0.1:9000
STORYFORGE_API_KEY=
STORYFORGE_GENERATION_MODEL=bedrock_claude_sonnet_4_6

# AWS production runtime (Lambda role supplies credentials)
GAMEFORGE_TABLE_NAME=
GAMEFORGE_COOKIE_SECRET=
GAMEFORGE_INVITE_SECRET=
GAMEFORGE_BUILD_SIGNING_SECRET=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
GAMEFORGE_PUBLIC_URL=
GAMEFORGE_BEDROCK_REGION=ap-northeast-2
GAMEFORGE_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
GAMEFORGE_BEDROCK_MAX_TOKENS=6000

# Local OpenAI-compatible model (Ollama / LM Studio)
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen3:8b
LOCAL_LLM_API_KEY=

# Server-side usage and cost guardrails
GAMEFORGE_MODEL_REQUESTS_PER_MINUTE=20
GAMEFORGE_MODEL_REQUESTS_PER_DAY=100
GAMEFORGE_MODEL_TOKENS_PER_DAY=500000
GAMEFORGE_MODEL_COST_USD_PER_DAY=10
GAMEFORGE_DEMO_REQUESTS_PER_MINUTE=30
GAMEFORGE_DEMO_REQUESTS_PER_DAY=500
GAMEFORGE_BEDROCK_INPUT_USD_PER_MILLION=3
GAMEFORGE_BEDROCK_OUTPUT_USD_PER_MILLION=15
